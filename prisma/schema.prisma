generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StoreSettings {
  id             String  @id @default(cuid())
  store_name     String
  logo           String?
  address        String
  phone          String
  whatsapp       String
  email          String?
  slogan         String?
  footer_receipt String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  username   String   @unique
  password   String
  name       String
  role       Role     @default(KASIR)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transactions Transaction[]
  shifts       CashShift[]
  audit_logs   AuditLog[]
}

enum Role {
  OWNER
  ADMIN
  KASIR
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  barcode     String?
  category_id String?
  category    Category? @relation(fields: [category_id], references: [id])
  unit        String   @default("pcs")
  buy_price   Decimal  @db.Decimal(15, 2)
  sell_price  Decimal  @db.Decimal(15, 2)
  stock       Int      @default(0)
  min_stock   Int      @default(5)
  image       String?
  description String?
  status      String   @default("aktif")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  transaction_items TransactionItem[]
  purchase_items    PurchaseItem[]
  stock_movements   StockMovement[]
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  address    String?
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  transactions Transaction[]
  debts        CustomerDebt[]
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  address    String?
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  purchases Purchase[]
  debts     SupplierDebt[]
}

model Transaction {
  id             String   @id @default(cuid())
  invoice        String   @unique
  date           DateTime @default(now())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id])
  customer_id    String?
  customer       Customer? @relation(fields: [customer_id], references: [id])
  subtotal       Decimal  @db.Decimal(15, 2)
  discount       Decimal  @default(0) @db.Decimal(15, 2)
  total          Decimal  @db.Decimal(15, 2)
  payment_method String
  amount_paid    Decimal  @db.Decimal(15, 2)
  change_amount  Decimal  @default(0) @db.Decimal(15, 2)
  status         String   @default("selesai")
  note           String?
  created_at     DateTime @default(now())

  items TransactionItem[]
}

model TransactionItem {
  id             String      @id @default(cuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product_id     String
  product        Product     @relation(fields: [product_id], references: [id])
  qty            Int
  price          Decimal     @db.Decimal(15, 2)
  discount       Decimal     @default(0) @db.Decimal(15, 2)
  total          Decimal     @db.Decimal(15, 2)
  buy_price      Decimal     @db.Decimal(15, 2)
}

model Purchase {
  id          String    @id @default(cuid())
  invoice     String?   @unique
  date        DateTime  @default(now())
  supplier_id String
  supplier    Supplier  @relation(fields: [supplier_id], references: [id])
  total       Decimal   @db.Decimal(15, 2)
  payment     String    @default("tunai")
  status      String    @default("lunas")
  note        String?
  created_at  DateTime  @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id          String  @id @default(cuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id  String
  product     Product @relation(fields: [product_id], references: [id])
  qty         Int
  price       Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)
}

model StockMovement {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id])
  qty        Int
  type       String
  reference  String?
  note       String?
  user_id    String?
  created_at DateTime @default(now())
}

model CustomerDebt {
  id          String   @id @default(cuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])
  amount      Decimal  @db.Decimal(15, 2)
  paid        Decimal  @default(0) @db.Decimal(15, 2)
  remaining   Decimal  @db.Decimal(15, 2)
  due_date    DateTime?
  status      String   @default("belum_lunas")
  note        String?
  created_at  DateTime @default(now())
}

model SupplierDebt {
  id          String   @id @default(cuid())
  supplier_id String
  supplier    Supplier @relation(fields: [supplier_id], references: [id])
  amount      Decimal  @db.Decimal(15, 2)
  paid        Decimal  @default(0) @db.Decimal(15, 2)
  remaining   Decimal  @db.Decimal(15, 2)
  due_date    DateTime?
  status      String   @default("belum_lunas")
  note        String?
  created_at  DateTime @default(now())
}

model CashTransaction {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  type       String
  amount     Decimal  @db.Decimal(15, 2)
  category   String?
  note       String?
  user_id    String?
  created_at DateTime @default(now())
}

model CashShift {
  id            String    @id @default(cuid())
  user_id       String
  user          User      @relation(fields: [user_id], references: [id])
  opened_at     DateTime  @default(now())
  closed_at     DateTime?
  initial_cash  Decimal   @db.Decimal(15, 2)
  cash_sales    Decimal   @default(0) @db.Decimal(15, 2)
  qris_sales    Decimal   @default(0) @db.Decimal(15, 2)
  transfer_sales Decimal  @default(0) @db.Decimal(15, 2)
  cash_in       Decimal   @default(0) @db.Decimal(15, 2)
  cash_out      Decimal   @default(0) @db.Decimal(15, 2)
  expected_cash Decimal?
  actual_cash   Decimal?
  difference    Decimal?
  status        String    @default("open")
  note          String?
}

model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  user       User?    @relation(fields: [user_id], references: [id])
  action     String
  detail     String?
  created_at DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}
